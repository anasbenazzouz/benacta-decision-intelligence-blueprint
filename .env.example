# BENACTA Decision Intelligence Blueprint — configuration
#
# DEMO_MODE=true is the default and the supported public configuration.
# The entire system — business objects, deterministic finance engine, controls,
# retrieval, approval, decision log and audit trail — works with no API key.
DEMO_MODE=true

