# BENACTA configuration. Copy to .env (gitignored) and fill locally. Never commit values.

# ----------------------------------------------------------------------------
# V1 Streamlit blueprint (app.py)
# DEMO_MODE=true is the supported public configuration: no API key needed.
# ----------------------------------------------------------------------------
DEMO_MODE=true
# ANTHROPIC_API_KEY=

# ----------------------------------------------------------------------------
# V2 Decision System Lab (apps/api)
# fixture: no Odoo, no LLM, no external credential
# odoo_sandbox: reads the connected Odoo; writes stay behind the write guard
# production is rejected by configuration validation.
# ----------------------------------------------------------------------------
BENACTA_MODE=fixture

# 1. Direct PostgreSQL read access to Odoo. Leave empty on Odoo Online (not offered).
ODOO_READ_DSN=

# 2. Odoo external API (JSON-2 on Odoo 19). API key scope: rpc.
ODOO_URL=
ODOO_DB=
ODOO_USERNAME=
ODOO_API_KEY=
ODOO_SOURCE_INSTANCE=benacta_odoo_online

# Write guard. Every item must hold before a seed or write-back runs.
ODOO_WRITES_ENABLED=false
# Comma-separated host/database pairs, e.g. example.odoo.com/example
ODOO_SANDBOX_ALLOWLIST=
# Fictional test company that seeds may touch. Protected companies are never accepted.
ODOO_SANDBOX_COMPANY=
ODOO_PROTECTED_COMPANIES=Benacta
# Human attestation of a downloaded backup: ISO date and file reference.
ODOO_BACKUP_ATTESTED_AT=
ODOO_BACKUP_REFERENCE=
ODOO_BACKUP_MAX_AGE_DAYS=7

# 3. BENACTA analytics database (PostgreSQL + pgvector). Never the Odoo database.
ANALYTICS_DATABASE_URL=
ANALYTICS_DB_EXPECTED_NAME=benacta_analytics

# 4. Ontology projection (rebuildable, never financial truth).
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# 5. Language models, server side only.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
